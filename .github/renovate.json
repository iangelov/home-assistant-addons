{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>iangelov/renovate-config"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^tailscale/Dockerfile$/"],
      "matchStringsStrategy": "any",
      "matchStrings": [
        "ARG TAILSCALE_VERSION=\"(?<currentValue>\\S+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "tailscale/tailscale"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^tailscale/Dockerfile$/"],
      "matchStringsStrategy": "any",
      "matchStrings": [
        "ARG BASE_IMAGE_VERSION=(?<currentValue>[0-9.]+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/hassio-addons/base",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Automerge non-major updates",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchDatasources": ["github-releases"],
      "matchDepNames": ["tailscale/tailscale"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchDatasources": ["docker"],
      "matchDepNames": ["ghcr.io/hassio-addons/base"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Bump the independent add-on version with dependency updates",
      "matchFileNames": ["tailscale/Dockerfile"],
      "rebaseWhen": "behind-base-branch",
      "bumpVersions": [
        {
          "filePatterns": ["tailscale/config.yaml"],
          "matchStrings": [
            "(?:^|\\n)version:\\s*\"(?<version>\\d+\\.\\d+\\.\\d+)\""
          ],
          "bumpType": "patch"
        }
      ]
    }
  ]
}
